# Скопируй этот файл в .env и заполни настоящими значениями.
# Настоящее .env в гит не коммитится (см. .gitignore).
# Формат — для бот-хостингов тоже подходит: те же переменные в настройках сервиса.

TELEGRAM_TOKEN=получить-у-BotFather
SHOP_API_TOKEN=ключ-магазина-источника
GTABLE_ID=ид-гугл-таблицы
# SHEET_API_KEY нужен только если таблица читается через API Google